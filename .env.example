# Cerberus local development configuration.
# Copy to .env only to override Docker Compose defaults. Never use these passwords in production.

# Infrastructure and public entry point
POSTGRES_DB=cerberus
POSTGRES_USER=cerberus
POSTGRES_PASSWORD=change-me-for-local-development
NGINX_PORT=8080
DJANGO_ADMIN_URL=admin/

# Development accounts created by the Core init script
CREATE_TEST_OPERATOR=true
TEST_OPERATOR_USERNAME=operator
TEST_OPERATOR_PASSWORD=operator-demo-password
CREATE_TEST_MANAGER=true
TEST_MANAGER_USERNAME=manager
TEST_MANAGER_PASSWORD=manager-demo-password
CREATE_TEST_ADMIN=true
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=admin-demo-password

# Core demo data and service identity used to submit recognition events to Cerberus
CREATE_DEMO_DATA=true
DEMO_EVENT_SUBMISSION_ENABLED=true
DEMO_SERVICE_USERNAME=janus-demo
DEMO_SERVICE_CLIENT_ID=janus-demo
DEMO_SERVICE_KEY=janus-demo-key

# Development-only mock barrier controller
MOCK_BARRIER_CONTROL_ENABLED=true
BARRIER_AUTO_CLOSE_SECONDS=10
BARRIER_CLOSE_RECONCILIATION_SECONDS=5

# Janus internal recognition service
# Use mock for deterministic demos; use tesseract only with cropped plate images.
JANUS_PORT=8001
JANUS_API_KEY=janus-local-development-key
JANUS_RECOGNITION_BACKEND=mock
JANUS_OPENCV_UPSCALE_FACTOR=2
JANUS_MAX_FILE_SIZE_BYTES=10485760
JANUS_PROCESSING_TIMEOUT_SECONDS=5

# Recognition-data retention (set RECOGNITION_RETENTION_ENABLED=false to disable cleanup)
RECOGNITION_RETENTION_ENABLED=true
RECOGNITION_IMAGE_METADATA_RETENTION_ENABLED=true
RECOGNITION_IMAGE_METADATA_RETENTION_DAYS=30
RECOGNITION_EVENT_RETENTION_ENABLED=true
RECOGNITION_EVENT_RETENTION_DAYS=180
RECOGNITION_AGGREGATE_AUDIT_RETENTION_ENABLED=true
RECOGNITION_AGGREGATE_AUDIT_RETENTION_DAYS=730
RECOGNITION_PURGE_INTERVAL_SECONDS=3600
