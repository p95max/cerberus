# Local Docker Compose defaults. Copy to .env only when you need to override them.
POSTGRES_DB=cerberus
POSTGRES_USER=cerberus
POSTGRES_PASSWORD=change-me-for-local-development

NGINX_PORT=8080

CREATE_DEMO_DATA=true
CREATE_TEST_OPERATOR=true
CREATE_TEST_ADMIN=true
TEST_OPERATOR_USERNAME=operator
TEST_OPERATOR_PASSWORD=operator-demo-password
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=admin-demo-password
