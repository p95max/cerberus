# Janus standalone local development configuration.
# Docker Compose receives the same values from the root .env file.

# Service runtime
JANUS_ENV=development
JANUS_PORT=8001
JANUS_API_KEY=change-me-for-local-development

# Recognition pipeline
# mock: filename-driven deterministic demo responses
# tesseract: OCR for an image already cropped to one licence plate
JANUS_RECOGNITION_BACKEND=mock
JANUS_OPENCV_UPSCALE_FACTOR=2
JANUS_MAX_FILE_SIZE_BYTES=10485760
JANUS_PROCESSING_TIMEOUT_SECONDS=5

# Reserved for the later Janus -> Cerberus integration phase
CERBERUS_CORE_URL=http://backend:8000
